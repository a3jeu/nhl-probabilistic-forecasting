# Copier ce fichier en .env et remplir les valeurs. Ne jamais committer .env.

# --- MySQL -------------------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=predistat
MYSQL_USER=kendal
MYSQL_PASSWORD=
# Utilisé seulement par docker-compose.yml (si MySQL roule dans Docker)
MYSQL_ROOT_PASSWORD=

# --- Sources de données ------------------------------------------------------
# API NHL (non documentée officiellement)
NHL_API_WEB_BASE_URL=https://api-web.nhle.com/v1
NHL_API_STATS_BASE_URL=https://api.nhle.com/stats/rest/en
# MoneyPuck (CSV)
MONEYPUCK_BASE_URL=https://moneypuck.com/moneypuck/playerData
# Politesse envers les serveurs : délai minimal entre requêtes (secondes)
HTTP_REQUEST_DELAY=1.0
HTTP_TIMEOUT=30
HTTP_USER_AGENT=nhl-probabilistic-forecasting (academic research, UQTR)

# --- Périmètre d'étude -------------------------------------------------------
# Saisons au format NHL (ex. 20102011)
SEASON_START=20052006
SEASON_END=20252026

# --- Chemins -----------------------------------------------------------------
DATA_DIR=data
REPORTS_DIR=reports
MODELS_DIR=models
LOG_LEVEL=INFO

# --- Reproductibilité --------------------------------------------------------
RANDOM_SEED=42
